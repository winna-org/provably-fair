{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [ "esnext" ],
    "moduleResolution": "node",
    "noImplicitAny": true, 
    "allowImportingTsExtensions": true,
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["dist","node_modules"] 
}

